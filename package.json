export const localAuthService = {
  getCurrentUser() {
    try {
      const stored = localStorage.getItem('politibet_user');
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  },

  login(username: string) {
    const user = {
      id: username.toLowerCase().replace(/\s+/g, '_'),
      username,
      createdAt: new Date().toISOString(),
    };
    localStorage.setItem('politibet_user', JSON.stringify(user));
    return user;
  },

  logout() {
    localStorage.removeItem('politibet_user');
  },
};

export const predictionService = {
  save(summary: any) {
    const key = `politibet_history_${summary.userId}`;
    const existing = this.getForUser(summary.userId);
    localStorage.setItem(key, JSON.stringify([summary, ...existing]));
  },

  getForUser(userId: string): any[] {
    try {
      const stored = localStorage.getItem(`politibet_history_${userId}`);
      return stored ? JSON.parse(stored) : [];
    } catch { return []; }
  },
};
